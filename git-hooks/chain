#!/bin/sh
# managed by oma-dotfile
# Installed under every hook name in the global core.hooksPath dir. Git then skips each
# repo's own .git/hooks, so this runs, in order, every executable in <name>.d/ next to it
# and then the repo's own <name> hook, stopping at the first one that fails.
name=$(basename "$0")
here=$(cd "$(dirname "$0")" && pwd -P) || exit 1

local_hook=
common=$(git rev-parse --git-common-dir 2>/dev/null)
if [ -n "$common" ] && [ -f "$common/hooks/$name" ] && [ -x "$common/hooks/$name" ]; then
    # A core.hooksPath that is the repo's own hooks dir would run this again.
    if [ "$(cd "$common/hooks" && pwd -P)" != "$here" ]; then
        local_hook="$common/hooks/$name"
    fi
fi

count=0
for hook in "$here/$name.d"/*; do
    if [ -f "$hook" ] && [ -x "$hook" ]; then count=$((count + 1)); fi
done
if [ -n "$local_hook" ]; then count=$((count + 1)); fi

if [ "$count" -eq 0 ]; then
    exit 0
fi
if [ "$count" -eq 1 ]; then
    # A single hook takes this process over, so it talks to git directly.
    for hook in "$here/$name.d"/*; do
        if [ -f "$hook" ] && [ -x "$hook" ]; then exec "$hook" "$@"; fi
    done
    exec "$local_hook" "$@"
fi

# Several hooks: each one gets the same stdin (pre-push and post-rewrite read it).
input=
if [ ! -t 0 ]; then
    input=$(mktemp) || exit 1
    trap 'rm -f "$input"' EXIT
    cat >"$input"
fi
run() {
    if [ -n "$input" ]; then "$@" <"$input"; else "$@"; fi
}
for hook in "$here/$name.d"/*; do
    if [ -f "$hook" ] && [ -x "$hook" ]; then run "$hook" "$@" || exit; fi
done
if [ -n "$local_hook" ]; then run "$local_hook" "$@" || exit; fi
exit 0
